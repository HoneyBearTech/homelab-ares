# Settings and secrets for one installation; only the *.example templates are committed
.env
.env.*
!.env.example
*.env
!*.env.example
.envrc

# Service data never belongs in the repo, even if someone points APPDATA_ROOT inside the checkout
appdata/
data/

# Backups written by scripts/backup.sh: they hold the services' logins, certificates and keys
backups/

# Release and CI outputs (generated by the workflows, never committed)
compose.json
sbom.cdx.json
SHA256SUMS*
*.tar.gz
trivy.sarif

# Keys and certificates (Nginx Proxy Manager's live in its data, never here)
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*

# The old in-repo vault path; project notes live in Chronos, never here
.obsidian-docs/

# Python tooling for scripts/ and tests/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
