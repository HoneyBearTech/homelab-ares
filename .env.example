# Settings for one homelab-ares installation. Copy to .env and restrict it (cp .env.example .env &&
# chmod 600 .env); .env is gitignored and never committed. Every setting the stack reads is listed here and in
# docs/interfaces.md.
#
# No secrets belong in this file. Each service keeps its own logins, tokens and certificates in its data (under
# CONFIG_ROOT).

# Time zone for logs and schedules (a tz database name).
TZ=Etc/UTC

# Host directory holding every service's data, one folder per service: <service>'s settings and database are in
# CONFIG_ROOT/<service>/config (npm, uptime-kuma, peanut, portainer), and Nginx Proxy Manager's certificates and
# log-rotation state beside them in CONFIG_ROOT/npm/letsencrypt and CONFIG_ROOT/npm/logrotate. A directory of your
# own, never inside /var/lib/docker/volumes: `docker volume prune` would delete it (docs/installing.md). Back it up
# (scripts/backup.sh does): it holds every login and the certificates' private keys. CONFIG_ROOT/peanut/config must
# be writable by uid 1000, which PeaNUT runs as.
CONFIG_ROOT=/srv/config

# The Docker network Nginx Proxy Manager joins. It is created once, outside the stack
# (docker network create homelab-ares_proxy), so its address range stays the same when the stack is recreated.
PROXY_NETWORK=homelab-ares_proxy
