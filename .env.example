# Settings for one homelab-ares installation. Copy to .env and restrict it (cp .env.example .env &&
# chmod 600 .env); .env is gitignored and never committed. Every setting the stack reads is listed here and in
# docs/interfaces.md.
#
# Planned: compose.yaml doesn't exist yet (see docs/roadmap.md). These are the settings it is expected to read;
# the list is settled when the services are added.
#
# No secrets belong in this file. Each service keeps its own logins, tokens and certificates in its data
# directory or volume.

# Time zone for logs and schedules (a tz database name).
TZ=Etc/UTC

# Host directory for the services' data (each service gets its own subdirectory). Back it up before every
# upgrade (docs/upgrading.md): it holds Nginx Proxy Manager's certificates and every service's logins.
APPDATA_ROOT=/srv/appdata
