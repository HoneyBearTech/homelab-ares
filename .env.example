# Settings for one homelab-ares installation. Copy to .env and restrict it (cp .env.example .env &&
# chmod 600 .env); .env is gitignored and never committed. Every setting the stack reads is listed here and in
# docs/interfaces.md.
#
# No secrets belong in this file. Each service keeps its own logins, tokens and certificates in its data.
# To adopt an existing installation, point each setting at the directory, volume or network it already uses
# (docs/installing.md#adopting-existing-containers).

# Time zone for logs and schedules (a tz database name).
TZ=Etc/UTC

# Nginx Proxy Manager: its settings database, proxy hosts and logs (/data), and its certificates, their private
# keys and any DNS-challenge credentials (/etc/letsencrypt). Host directories; back them up.
NPM_DATA_PATH=/srv/appdata/npm/data
NPM_LETSENCRYPT_PATH=/srv/appdata/npm/letsencrypt

# The Docker network Nginx Proxy Manager joins. It is created once, outside the stack
# (docker network create homelab-ares_proxy), so its address range stays the same when the stack is recreated.
PROXY_NETWORK=homelab-ares_proxy

# Uptime Kuma's database (/app/data): a Docker volume.
UPTIME_KUMA_VOLUME=homelab-ares_uptime-kuma

# PeaNUT's settings (/config), including the NUT server's address and login: a host directory.
PEANUT_CONFIG_PATH=/srv/appdata/peanut

# Portainer's database (/data): a Docker volume.
PORTAINER_VOLUME=homelab-ares_portainer
