{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "enabledManagers": [
    "docker-compose",
    "pip_requirements",
    "github-actions",
    "gitlabci",
    "pre-commit"
  ],
  "pre-commit": {
    "enabled": true
  },
  "schedule": ["before 6am on monday"],
  "timezone": "America/Chicago",
  "labels": ["dependencies"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "osvVulnerabilityAlerts": true,
  "automerge": false,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "minor and patch dependencies"
    },
    {
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "addLabels": ["major"]
    }
  ]
}
