{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "enabledManagers": [
    "docker-compose",
    "pip-compile",
    "github-actions",
    "gitlabci",
    "pre-commit",
    "custom.regex"
  ],
  "pre-commit": {
    "enabled": true
  },
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "America/Chicago",
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security",
      "openssf"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "An image rebuild (a new digest under the same tag) skips the 3-day wait: Docker Hub dates a rebuild by the tag's last push, so a tag rebuilt about weekly would restart the clock each time and never get through the Monday-only schedule. Only images: a moved tag on a pre-commit hook or an Action keeps the wait.",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "minimumReleaseAge": null
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "minor and patch dependencies"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "addLabels": [
        "major"
      ]
    },
    {
      "description": "Portainer is updated by hand: its server and its agents must be updated together. Never merged automatically. Kept out of the update group (its own pull request), because a group merges automatically only when every update in it may.",
      "matchPackageNames": [
        "portainer/portainer-ce",
        "portainer/agent"
      ],
      "automerge": false,
      "groupName": null
    }
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/^requirements-dev\\.txt$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pinned helper and CI images outside native Docker managers",
      "managerFilePatterns": [
        "/^scripts/lib\\.sh$/",
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?<depName>[a-z0-9][a-z0-9._/-]*):(?<currentValue>[a-zA-Z0-9][a-zA-Z0-9._-]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  }
}
